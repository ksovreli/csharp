@model IEnumerable<mvc_architecture.Models.Entities.TodoListItem>
@{
	ViewData["Title"] = "To-do List Page";
}

<h1>To-do Lists</h1>

<a class="btn btn-secondary" asp-action="Create">
    Add new list.
</a>

@if (!Model.Any())
{
    <p>There is no list.</p>
}

@if (Model.Any())
{
    <table>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Created Date</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.CreatedDate</td>
            </tr>
        }
    </table>
}
